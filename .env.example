# Alpaca paper credentials. Never put live API credentials in this project.
ALPACA_API_KEY=replace_me
ALPACA_API_SECRET=replace_me
ALPACA_PAPER=true
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Bot defaults
BOT_SYMBOLS=BTC/USD,ETH/USD
BOT_TIMEFRAME=15Min
BOT_MAX_POSITION_PCT=0.10
BOT_ACCOUNT_RISK_PER_TRADE_PCT=0.0025
BOT_DAILY_DRAWDOWN_PCT=0.01
BOT_TOTAL_DRAWDOWN_PCT=0.05
BOT_MAX_SPREAD_BPS=35
BOT_MAX_FEED_AGE_SECONDS=90
BOT_STOP_LOSS_ATR=3
BOT_MAX_ORDERS_PER_CYCLE=2
BOT_MAX_CONSECUTIVE_ERROR_CYCLES=3
BOT_POLL_SECONDS=60
BOT_BACKFILL_DAYS=30
BOT_MIN_BARS=80
BOT_AUTOSTART=false

# Storage
DATABASE_URL=postgresql://bot:bot@db:5432/bot
